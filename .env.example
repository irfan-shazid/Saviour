# Copy to .env. Values prefixed EXPO_PUBLIC_ are inlined into the app bundle,
# so never put a secret here — this is only the server's public address.

# Base URL of the Better Auth server in server/.
# On a physical phone this must be your machine's LAN IP (the same one Expo
# prints as exp://<ip>:8081), NOT localhost — the phone can't reach your
# laptop's loopback interface.
#
# Leave blank to run Saviour fully local-only, with no account screen.
EXPO_PUBLIC_AUTH_URL=http://192.168.0.100:8787
