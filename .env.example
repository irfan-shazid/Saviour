# ============================================================================
#  Saviour app (Expo) — environment
#  Copy to .env in the project root.
#
#  EXPO_PUBLIC_* values are INLINED INTO THE APP BUNDLE at build time. They
#  are readable by anyone who has the app. Never put a secret here — the
#  database URL, the auth secret and the SMTP password all live in
#  server/.env, which never reaches the phone.
#
#  After changing anything here, restart Metro with a cleared cache:
#      npx expo start -c
#  A plain reload will NOT pick up a change.
# ============================================================================

# Base URL of the Saviour server (the one in server/). This is used for both
# authentication and data sync.
#
# It must be reachable FROM THE PHONE:
#   • Physical phone in development → your machine's LAN IP. This is the same
#     address Expo prints as exp://192.168.x.x:8081.
#   • Android emulator            → http://10.0.2.2:8787
#   • iOS simulator               → http://localhost:8787
#   • Production                  → your https:// URL
#
# Must match BETTER_AUTH_URL in server/.env.
#
# Leave BLANK to run Saviour completely local-only: no account screen, no
# sync, everything on-device. Fall detection and SOS work either way.
EXPO_PUBLIC_AUTH_URL=http://192.168.0.100:8787
