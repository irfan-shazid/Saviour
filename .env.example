# ============================================================================
#  Saviour app (Expo) — environment
#  Copy to .env in the project root.
#
#  EXPO_PUBLIC_* values are INLINED INTO THE APP BUNDLE at build time and are
#  readable by anyone who has the app. Never put a secret here — the database
#  URL, the auth secret and the Google client secret all live in server/.env,
#  which never reaches the phone.
#
#  After changing this, restart Metro with a cleared cache:
#      npx expo start -c
#  A plain reload will NOT pick up the change.
# ============================================================================

# Base URL of the Saviour server (the one in server/), used for both
# authentication and data sync. Must match BETTER_AUTH_URL in server/.env.
#
# Reachability, which is where this usually goes wrong:
#   • Physical phone   → your machine's LAN IP, e.g. http://192.168.0.100:3000
#                        (the same address Expo prints as exp://192.168.x.x:8081)
#   • Android emulator → http://10.0.2.2:3000
#   • iOS simulator    → http://localhost:3000
#   • Production       → your https:// URL
#
# Leave BLANK to run Saviour completely local-only: no account screen, no
# sync, everything on-device. Fall detection and SOS work either way.
EXPO_PUBLIC_AUTH_URL=http://localhost:3000
