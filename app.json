{
  "expo": {
    "name": "Saviour",
    "slug": "Saviour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Saviour needs your location so it can be sent to your emergency contacts if you have an accident.",
        "NSMotionUsageDescription": "Saviour uses motion sensors to detect falls and accidents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Saviour needs your location so it can be sent to your emergency contacts if you have an accident."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF4444"
        }
      ]
    ]
  }
}
