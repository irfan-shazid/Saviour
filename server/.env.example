# ============================================================================
#  Saviour auth + data server — environment
#  Copy to server/.env and fill in. Never commit the real .env.
# ============================================================================

# ---------------------------------------------------------------- DATABASE --
# Neon Postgres connection string. REQUIRED.
#
# Get it from https://console.neon.tech → your project → Connection Details.
# Use the POOLED connection (the host contains "-pooler"), and keep
# ?sslmode=require on the end.
#
# Format:
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------------------------------- AUTH --
# Session signing key. REQUIRED. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL this server answers on. Must be reachable FROM THE PHONE, so for
# local development use your machine's LAN IP — not localhost, which on a
# phone means the phone itself. In production use the https:// URL.
BETTER_AUTH_URL=http://192.168.0.100:8787

# Port to bind. Optional, defaults to 8787.
PORT=8787

# Custom URL scheme the app is registered under. Must match "scheme" in
# app.json. Optional, defaults to "saviour".
APP_SCHEME=saviour

# ------------------------------------------------------------ GOOGLE OAUTH --
# Optional — leave blank to run with email/password only.
#
# Create at https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   → Authorised redirect URI (must match EXACTLY):
#         <BETTER_AUTH_URL>/api/auth/callback/google
#     e.g. http://192.168.0.100:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------- EMAIL --
# REQUIRED for email/password sign-up, because email verification is on:
# without SMTP the verification link cannot be delivered and nobody can
# complete sign-up. Google sign-in is unaffected (Google proves the address).
#
# Any SMTP provider works. Examples:
#
#   Gmail (needs a 16-char App Password, not your login password —
#          https://myaccount.google.com/apppasswords):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_SECURE=false
#     SMTP_USER=you@gmail.com
#     SMTP_PASS=abcd efgh ijkl mnop
#
#   Resend:      SMTP_HOST=smtp.resend.com   SMTP_PORT=587  SMTP_USER=resend
#   Mailtrap:    SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
#
# Leave blank during development and the verification URL is printed to the
# server console instead — paste it into a browser to verify by hand.
SMTP_HOST=
SMTP_PORT=587
# true only for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The From: header on verification and password-reset mail. Some providers
# require this to be a domain you've verified with them.
EMAIL_FROM=Saviour <no-reply@saviour.app>
