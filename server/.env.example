# ============================================================================
#  Saviour auth + data server — environment
#  Copy to server/.env and fill in. Never commit the real .env.
#
#  There is NO email verification and NO OTP, so no SMTP settings are needed.
#  Sign-up creates the account and signs the user straight in.
# ============================================================================

# ---------------------------------------------------------------- DATABASE --
# Neon Postgres connection string. REQUIRED.
#
# https://console.neon.tech → your project → Connection Details.
# Use the POOLED connection (the host contains "-pooler") and keep
# ?sslmode=require on the end.
#
# Format:
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# -------------------------------------------------------------------- AUTH --
# Session signing key. REQUIRED. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL this server answers on, and the port it binds.
#
# "localhost" resolves to whatever device asks for it, so it only works when
# the client is on this same machine. To reach the server from a physical
# phone, use your machine's LAN IP here and in the app's EXPO_PUBLIC_AUTH_URL
# (an Android emulator uses http://10.0.2.2:<port>).
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# Must match "scheme" in app.json.
APP_SCHEME=saviour

# ------------------------------------------------------------ GOOGLE OAUTH --
# Optional — leave blank to run with email/password only.
#
# https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   → Authorised redirect URI, matching EXACTLY:
#         <BETTER_AUTH_URL>/api/auth/callback/google
#     e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
