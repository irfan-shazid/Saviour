# Copy to server/.env and fill in. Never commit the real .env.

# Signing secret for sessions. Generate one:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL this server is reachable at. For a phone on the same Wi-Fi this
# must be your machine's LAN IP, not localhost — the phone can't reach your
# laptop's loopback.
BETTER_AUTH_URL=http://192.168.0.100:8787

PORT=8787
DATABASE_PATH=./saviour-auth.db

# Custom URL scheme the app is registered under (matches app.json "scheme").
APP_SCHEME=saviour

# Google OAuth. Create credentials at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave both blank to run with email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
