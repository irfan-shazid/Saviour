{
  "name": "saviour-auth-server",
  "version": "1.0.0",
  "private": true,
  "description": "Better Auth server for the Saviour app (Google + email/password).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "verify": "tsx src/verify.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.2",
    "better-auth": "^1.7.2",
    "cors": "^2.8.5",
